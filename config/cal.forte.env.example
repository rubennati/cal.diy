# cal.forte — hardened first-instance config (EXAMPLE · public-safe placeholders)
#
# Copy into your PRIVATE deployment (secure-docker-blueprint), fill the __placeholders__,
# and inject every *_SECRET / *_KEY / *_PASSWORD / DATABASE_URL as a Docker secret —
# never commit real values here (this repo is public).
#
# Tailored to a single-user calendar with: Brevo SMTP · Microsoft (Outlook + Teams) ·
# Zoom · Apple/CalDAV · optional Google. Full reference: ../.ai/env-reference.md ·
# hardening how-to: ../.ai/hardening-checklist.md

# ── Core (required) ────────────────────────────────────────────────
NEXT_PUBLIC_WEBAPP_URL=https://cal.your-domain.tld
NEXTAUTH_URL=https://cal.your-domain.tld
DATABASE_URL=postgresql://cal:__secret__@database:5432/calendso      # Docker secret
DATABASE_DIRECT_URL=postgresql://cal:__secret__@database:5432/calendso
NEXTAUTH_SECRET=__docker_secret__            # openssl rand -base64 32
CALENDSO_ENCRYPTION_KEY=__docker_secret__    # openssl rand -base64 24 — encrypts stored app creds
TZ=UTC

# ── Hardening (recommended) ────────────────────────────────────────
CRON_API_KEY=__set_random__                  # openssl rand -hex 16 — MUST replace the shipped default
ALLOWED_HOSTNAMES='"cal.your-domain.tld"'
NEXTAUTH_COOKIE_DOMAIN=your-domain.tld
CSP_POLICY=non-strict
# Telemetry + ad-tracking are already OFF by default in the image (no need to set).
# NEXT_PUBLIC_DISABLE_SIGNUP is build-time — see "First run" in ../.ai/hardening-checklist.md.

# ── Email — Brevo SMTP ─────────────────────────────────────────────
EMAIL_SERVER_HOST=smtp-relay.brevo.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=__your_brevo_login__
EMAIL_SERVER_PASSWORD=__docker_secret__      # Brevo SMTP key — Docker secret (the class that leaked before)
EMAIL_FROM=calendar@your-domain.tld
EMAIL_FROM_NAME=cal.forte

# ── Microsoft — Outlook calendar + Teams meetings ──────────────────
MS_GRAPH_CLIENT_ID=__your_ms_app_client_id__
MS_GRAPH_CLIENT_SECRET=__docker_secret__
OUTLOOK_LOGIN_ENABLED=false                  # set true only if you also want Microsoft login
MICROSOFT_WEBHOOK_TOKEN=__docker_secret__    # verifies inbound MS calendar webhooks

# ── Zoom — meeting links ───────────────────────────────────────────
ZOOM_CLIENT_ID=__your_zoom_client_id__
ZOOM_CLIENT_SECRET=__docker_secret__

# ── Google (optional) — calendar + meet ────────────────────────────
# GOOGLE_API_CREDENTIALS={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."]}}
# GOOGLE_LOGIN_ENABLED=false                 # configure the Google app as *Internal* when self-hosting
# GOOGLE_WEBHOOK_TOKEN=__docker_secret__

# ── Apple + CalDAV ─────────────────────────────────────────────────
# No global keys needed — each user connects their own Apple/CalDAV account in the UI.
# These apps are enabled at boot automatically (shouldEnableApp: they require no keys).

# ── Everything else: leave UNSET ───────────────────────────────────
# Every empty integration key = that app stays disabled and makes no outbound calls
# (analytics widgets, other CRMs, AI voice, payments, orgs/teams…). See ../.ai/env-reference.md.
